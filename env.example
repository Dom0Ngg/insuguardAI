# ============================================================
# InsurGuard AI - Variables de entorno de ejemplo
# Copia este archivo como .env y completa solo los valores necesarios.
# NO subas el archivo .env real al repositorio.
# ============================================================

# ----------------------------
# Telegram Bot
# ----------------------------
# Token generado por @BotFather.
# Ejemplo de formato: 1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=

# Activa la recepción de mensajes mediante long polling.
TELEGRAM_POLLING_ENABLED=true

# Tiempo máximo (segundos) de espera por petición getUpdates.
TELEGRAM_POLL_TIMEOUT=25

# true = descarta mensajes pendientes al arrancar el bot.
# false = procesa los mensajes pendientes.
TELEGRAM_DROP_PENDING_UPDATES=false

# API oficial de Telegram. Normalmente no hay que cambiarla.
TELEGRAM_API_BASE_URL=https://api.telegram.org

# ----------------------------
# RAG / PostgreSQL + pgvector
# ----------------------------
# Dentro de Docker, el host de PostgreSQL es "postgres".
RAG_DATABASE_URL=postgresql://insurguard:insurguard@postgres:5432/insurguard

# Modelo multilingüe usado para generar embeddings de las pólizas.
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_DIMENSION=384

# Configuración del chunking de pólizas.
RAG_CHUNK_SIZE_WORDS=220
RAG_CHUNK_OVERLAP_WORDS=40
